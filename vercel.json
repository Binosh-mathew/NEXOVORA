{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "nexovora.tech" }
      ],
      "destination": "https://www.nexovora.tech/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
